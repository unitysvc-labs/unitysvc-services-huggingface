{
{#- Model-family logo (unitysvc/unitysvc-data#60): the catalog row shows the
    model's own mark rather than the provider's — the model is what a customer
    recognises, and the provider is already named beside it. Resolved from the
    model id, so no per-model parameter is needed and the populate script
    cannot destroy it. A model the registry does not know resolves to null,
    which creates no document and leaves the provider logo in place, so the key
    needs no conditional. -#}
  "logo": {{ {"$logo_preset": offering_name} | tojson }},
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- Chat/LLM detection mirrors listing.json.j2's capability branching. The
    OpenAI/Anthropic dialect translator, the dual input/output formats, and the
    dialect-aware marketplace copy apply ONLY to text-generation/chat models
    (incl. image-text-to-text VLMs). Non-chat capabilities (ASR/TTS/image/video/
    embeddings/guard) keep the plain channel with no translator/formats. #}
{#- Dispatch moved off `capabilities` onto `details.pipeline_tag`. The two held
    the identical value, but they are different axes: pipeline_tag is
    HuggingFace's task taxonomy (an upstream fact, and the right thing to branch
    on), while `capabilities` is now the platform vocabulary
    (unitysvc docs/capabilities.yml) — a customer-facing promise. -#}
{%- set _pt = (details.pipeline_tag | default("", true)) -%}
{%- set _pt_capability = {
      "feature-extraction": "embed", "sentence-similarity": "embed",
      "text-to-image": "image-generate", "unconditional-image-generation": "image-generate",
      "image-to-image": "image-edit",
      "automatic-speech-recognition": "speech-transcribe",
      "text-to-speech": "speech-synthesize", "text-to-audio": "speech-synthesize",
      "text-to-video": "video-generate", "image-to-video": "video-generate",
  } -%}
{%- set _cap = _pt_capability.get(_pt, "chat") -%}
{%- set is_chat = (_cap == "chat") -%}
{#- A vision-language model is a chat model that ALSO accepts an image
    alongside the text instruction. That second call has its own defined input
    and its own code examples, so it is a capability rather than a flag —
    `image-text-to-text`, which is also HuggingFace's own task id, so the
    mapping is an identity here. It is declared BESIDE `chat`, never instead
    of it: the same endpoint still holds a plain text conversation. -#}
{%- set is_vision = (_pt == "image-text-to-text") -%}
{%- set _caps = ["chat", "image-text-to-text"] if is_vision else [_cap] -%}
{#- Marketplace copy (unitysvc/unitysvc#1838): the teaser paragraph now lives
    in the required `summary` field (max 200 chars, shown in the collapsed
    list view); `description` holds the long-form paragraphs (the populate
    script emits a one-line brief, so compose the rest here). #}
{%- set _base = description | default(display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name, true) %}
{%- set _dual = ' — callable in both OpenAI and Anthropic API styles through the UnitySVC gateway.' %}
{%- set _brief = (_base ~ _dual) if ((_base | length) + (_dual | length) < 195) else _base %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details.context_length else '' %}
{%- if is_chat %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' over an OpenAI-compatible API' ~ _ctx ~ '. Requests are proxied through the UnitySVC gateway.' %}
{%- set _howto = 'Reach it through the UnitySVC gateway with your own ' ~ provider_display_name ~ ' API key (the byok channel). See the code examples for both styles.' %}
{%- else %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' and proxied through the UnitySVC gateway' ~ _ctx ~ '. Requests are billed per use.' %}
{%- set _howto = 'Reach it through the UnitySVC gateway with your own ' ~ provider_display_name ~ ' API key (the byok channel). See the code examples for the request and response shape this model uses.' %}
{%- endif %}
{#- Dedicated interoperability paragraph: the dual-dialect endpoint is the
    platform differentiator and what makes services interchangeable enough to
    sit behind the gateway's composition primitives. #}
{%- set _interop = 'One endpoint, either dialect — send an OpenAI Chat Completions or an Anthropic Messages request and the gateway auto-detects the format, translates it for the upstream, and replies in the style you sent. Because every model on UnitySVC speaks both dialects, they are interchangeable behind a single client: swap providers without touching your code, and combine them with the gateway composition primitives — group (/g/), broadcast (/b/), chain (/c/) and failover (/f/).' %}
{#- Closing pricing paragraph. The price cell now carries "why free" itself — a
    BYOK pill beside the amount (see listing.json.j2) — so this paragraph no
    longer repeats it and states only the rate. It is not redundant with the
    cell's hover note: a `title` attribute is unreachable on touch, absent from
    the API/MCP catalog surface, and not searchable, and for a BYOK listing the
    upstream rate is the difference between free and real money. #}
{%- set _byok = 'Pricing — usage is billed by ' ~ provider_display_name ~ ' directly' ~ (' at ' ~ pricing_note if pricing_note else '') ~ '.' %}
{%- set _description = _detail ~ '\n\n' ~ _howto ~ '\n\n' ~ _interop ~ '\n\n' ~ _byok %}
  "summary": {{ (_brief | trim)[:200] | tojson }},
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
  "capabilities": {{ _caps | tojson }},
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  "tags": ["ai", "gateway", "byok"],
{%- if is_chat %}
{#- Merge the dual-dialect formats into the provider's details (R8); the
    llm_translator below exposes the OpenAI upstream in both dialects. #}
{%- set _details = details.copy() %}
{%- set _ = _details.update({"input_formats": ["openai", "anthropic"], "output_formats": ["openai_response", "anthropic_response"]}) %}
  "details": {{ _details | tojson }},
{%- else %}
  "details": {{ details | tojson }},
{%- endif %}
{%- if payout_price %}
  "payout_price": {{ payout_price | tojson }},
{%- endif %}
  "upstream_access_config": {
    "byok": {
      "access_method": "http",
      "base_url": "{{ api_base_url | replace('/v1', '') }}",
      "api_key": "${ customer_secrets.{{ env_api_key_name }} }",
      "rate_limits": [],
{%- if is_chat %}
      "routing_key": {"model": "{{ offering_name }}"},
      "request_transformer": {"llm_translator": "anthropic_to_openai"}
{%- else %}
      "routing_key": {"model": "{{ offering_name }}"}
{%- endif %}
    }
  }
}
