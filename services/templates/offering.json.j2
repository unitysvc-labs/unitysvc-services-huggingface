{
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- Chat/LLM detection mirrors listing.json.j2's capability branching. The
    OpenAI/Anthropic dialect translator, the dual input/output formats, and the
    dialect-aware marketplace copy apply ONLY to text-generation/chat models
    (incl. image-text-to-text VLMs). Non-chat capabilities (ASR/TTS/image/video/
    embeddings/guard) keep the plain channel with no translator/formats. #}
{%- if "automatic-speech-recognition" in capabilities
    or "text-to-speech" in capabilities or "text-to-audio" in capabilities
    or "text-to-video" in capabilities or "image-to-video" in capabilities
    or "image-to-image" in capabilities
    or "text-to-image" in capabilities or "unconditional-image-generation" in capabilities
    or "feature-extraction" in capabilities or "sentence-similarity" in capabilities
    or "guard" in (capabilities | join(" ")) -%}
  {%- set is_chat = false -%}
{%- else -%}
  {%- set is_chat = true -%}
{%- endif -%}
{#- 3-paragraph marketplace description (the validator requires >=2 paragraphs;
    the populate script emits a one-line brief). Teaser + detail + how-to. #}
{%- set _brief = description | default(display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name, true) %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details.context_length else '' %}
{%- if is_chat %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' over an OpenAI-compatible API' ~ _ctx ~ '. Requests are proxied through the UnitySVC gateway and billed per token.' %}
{%- set _howto = 'Reach it through the UnitySVC gateway with your own ' ~ provider_display_name ~ ' API key (the byok channel). The endpoint accepts both OpenAI Chat Completions and Anthropic Messages requests — the gateway auto-detects the dialect, translates to the upstream, and returns the response in the format you sent. See the code examples for both styles.' %}
{%- else %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' and proxied through the UnitySVC gateway' ~ _ctx ~ '. Requests are billed per use.' %}
{%- set _howto = 'Reach it through the UnitySVC gateway with your own ' ~ provider_display_name ~ ' API key (the byok channel). See the code examples for the request and response shape this model uses.' %}
{%- endif %}
{%- set _description = _brief ~ '\n\n' ~ _detail ~ '\n\n' ~ _howto %}
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
  "capabilities": {{ capabilities | tojson }},
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  "tags": ["ai", "gateway", "byok"],
{%- if is_chat %}
{#- Merge the dual-dialect formats into the provider's details (R8); the
    llm_translator below exposes the OpenAI upstream in both dialects. #}
{%- set _details = details.copy() %}
{%- set _ = _details.update({"input_formats": ["openai", "anthropic"], "output_formats": ["openai_response", "anthropic_response"]}) %}
  "details": {{ _details | tojson }},
{%- else %}
  "details": {{ details | tojson }},
{%- endif %}
{%- if payout_price %}
  "payout_price": {{ payout_price | tojson }},
{%- endif %}
  "upstream_access_config": {
    "byok": {
      "access_method": "http",
      "base_url": "{{ api_base_url | replace('/v1', '') }}",
      "api_key": "${ customer_secrets.{{ env_api_key_name }} }",
      "rate_limits": [],
{%- if is_chat %}
      "routing_key": {"model": "{{ offering_name }}"},
      "request_transformer": {"llm_translator": "anthropic_to_openai"}
{%- else %}
      "routing_key": {"model": "{{ offering_name }}"}
{%- endif %}
    }
  }
}
