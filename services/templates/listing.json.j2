{#- Select code example templates from the model's HuggingFace task taxonomy.
    Branches on `details.pipeline_tag`, NOT on `capabilities`: the two used to
    hold the identical value, but `capabilities` now carries the platform
    vocabulary (unitysvc docs/capabilities.yml) and pipeline_tag is the upstream
    fact this dispatch actually depends on. Keeping them separate means a change
    to the customer-facing vocabulary cannot silently re-route examples. -#}
{%- set _pt = (details.pipeline_tag | default("", true)) -%}
{%- if _pt == "automatic-speech-recognition" -%}
  {%- set ex = "-prerecordedtranscription" -%}
{%- elif _pt in ("text-to-speech", "text-to-audio") -%}
  {%- set ex = "-tts" -%}
{%- elif _pt in ("text-to-video", "image-to-video") -%}
  {%- set ex = "-ttv" -%}
{%- elif _pt == "image-to-image" -%}
  {%- set ex = "-imagetoimage" -%}
{%- elif _pt in ("text-to-image", "unconditional-image-generation") -%}
  {%- set ex = "-image" -%}
{%- elif _pt in ("feature-extraction", "sentence-similarity") -%}
  {%- set ex = "-sentencetransformers" -%}
{%- else -%}
  {%- set ex = "" -%}
{%- endif -%}

{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
{#- Price-cell copy follows the marketplace description grammar
    (unitysvc/unitysvc#1886, PR #1887):

        <amount> [ ~<intent> <PILL> ] [ | <hover note> ]

    BYOK is *why* the gateway price is free, so it rides the badge slot and
    renders as a pill beside the amount. A bare `~` selects the default
    intent — a saving — which is the green fill. The provider's reference
    rates ride the `|` note: that slot is taken first and consumed to
    end-of-string, so everything in it is inert — a rate card may contain
    "/" and "per" without being re-parsed as a unit. Only about half the
    catalog has rates (litellm covers the models it knows), so the note is
    conditional: without one the cell degrades to a bare "Free ~ BYOK" with
    no dangling separator.

    Composed here rather than written into the param file because
    scripts/update_params.py rebuilds list_price on the nightly populate run
    (02:00 UTC) and would drop a hand-edited description within a day.
    dict(...) overrides only the description, leaving price/type alone, and
    copies rather than mutates — update_params.py hands the SAME dict object
    to list_price and payout_price, and payout_price is seller-facing copy
    that must not pick up the customer-facing pill. #}
{%- set _rate = (' | usage is billed by ' ~ provider_display_name ~ ' directly at ' ~ pricing_note) if pricing_note else '' %}
  "list_price": {{ dict(list_price, description='Free ~ BYOK' ~ _rate) | tojson }},
{%- endif %}

  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {
        "model": "{{ offering_name }}"
      }
    }
  },

  "documents": {

    "How to use this model": {
      "$doc_preset": "llm_description"
    },

{%- if ex == "" %}
    "Python code example": {
      "$doc_preset": {"name": "llm_code_example_openai", "meta": {"sleep_after_test": 5}}
    },

    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}}
    },

    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_javascript", "meta": {"sleep_after_test": 5}}
    },

    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_shell", "meta": {"sleep_after_test": 5}}
    },

    {#- Anthropic-dialect examples (R9): the HuggingFace router speaks OpenAI, so
        specs run-tests (local_testing) calls it in OpenAI form, while the
        gateway path speaks Anthropic and exercises the llm_translator. Chat
        models only. #}
    "Python code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_sdk", "meta": {"sleep_after_test": 5}}
    },

    "cURL code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_shell", "meta": {"sleep_after_test": 5}}
    },
{%- else %}
    "Python code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code-example{{ ex }}.py.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "python",
      "meta": {"sleep_after_test": 5}
    },

    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}}
    },

    "JavaScript code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code-example{{ ex }}.js.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "javascript",
      "meta": {"sleep_after_test": 5}
    },

    "cURL code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code-example{{ ex }}.sh.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "bash",
      "meta": {"sleep_after_test": 5}
    },
{%- endif %}

    "Connectivity test": {
      "$doc_preset": {"name": "llm_connectivity", "meta": {"sleep_after_test": 5}}
    },

    "Default request body": {
      "$doc_preset": "llm_request_template"
    }

  }
}
