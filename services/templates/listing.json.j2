{%- set _pt = (details.pipeline_tag | default("", true)) -%}
{#- Branch on HuggingFace's task taxonomy, not on `capabilities`: the platform
    vocabulary is customer-facing, while `pipeline_tag` is the upstream fact that
    tells the example collection which capability shape to demonstrate. -#}
{%- set _pt_capability = {
      "feature-extraction": "embed", "sentence-similarity": "embed",
      "text-to-image": "image-generate", "unconditional-image-generation": "image-generate",
      "image-to-image": "image-edit",
      "automatic-speech-recognition": "speech-to-text",
      "text-to-speech": "text-to-speech", "text-to-audio": "text-to-speech",
      "text-to-video": "video-generate", "image-to-video": "video-generate",
      "text-classification": "moderate",
      "text-ranking": "rerank",
  } -%}
{%- set _capability = _pt_capability.get(_pt, "chat") -%}
{%- set _capabilities = ["chat", "image-text-to-text"] if _pt == "image-text-to-text" else [_capability] -%}
{%- set _formats = ["openai", "anthropic"] if _capability == "chat" else ["openai"] -%}

{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ service_name }}",
{%- if list_price %}
{#- Price-cell copy follows the marketplace description grammar
    (unitysvc/unitysvc#1886, PR #1887):

        <amount> [ ~<intent> <PILL> ] [ | <hover note> ]

    BYOK is *why* the gateway price is free, so it rides the badge slot and
    renders as a pill beside the amount. A bare `~` selects the default
    intent — a saving — which is the green fill. The provider's reference
    rates ride the `|` note: that slot is taken first and consumed to
    end-of-string, so everything in it is inert — a rate card may contain
    "/" and "per" without being re-parsed as a unit. Only about half the
    catalog has rates (litellm covers the models it knows), so the note is
    conditional: without one the cell degrades to a bare "Free ~ BYOK" with
    no dangling separator.

    Composed here rather than written into the param file because
    scripts/update_params.py rebuilds list_price on the nightly populate run
    (02:00 UTC) and would drop a hand-edited description within a day.
    dict(...) overrides only the description, leaving price/type alone, and
    copies rather than mutates — update_params.py hands the SAME dict object
    to list_price and payout_price, and payout_price is seller-facing copy
    that must not pick up the customer-facing pill. #}
{%- set _rate = (' | usage is billed by ' ~ provider_display_name ~ ' directly at ' ~ pricing_note) if pricing_note else '' %}
  "list_price": {{ dict(list_price, description='Free ~ BYOK' ~ _rate) | tojson }},
{%- endif %}

  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {
        "model": "{{ offering_name }}"
      }
    }
  },

  {#- Every document below is derived from what this service is: its
      HuggingFace task/capability and the request dialects it accepts
      (unitysvc/unitysvc#1899). The shared `llm_example_collection` carries the
      catalog-wide example shape, connectivity probe selection, request
      template, sleep spacing, vision examples, and tool-example gating.

      Vision-language models declare both `chat` and `image-text-to-text`, so
      the collection emits both plain-chat and image-bearing examples while
      keeping one connectivity probe. #}
  "documents": {
    "$llm_example_collection": {
      "capabilities": {{ _capabilities | tojson }},
      "formats": {{ _formats | tojson }},
      "upstream_dialect": "openai",
      "tools": {{ (supports_tools | default(false)) | tojson }},
      "sleep": 5
    }
  }
}
